# Copy to .env and replace every value marked required. The server refuses to
# start while a required value is missing or unchanged from this file.

# Required. Postgres connection.
DATABASE_URL=postgres://app:change-me@postgres:5432/app

# Required. Django signing key, at least 32 characters.
SECRET_KEY=change-me

# Required. Encrypts TOTP secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=change-me

# Required. External URL of the app; sets the allowed host, CSRF origin and
# whether cookies are marked Secure.
PUBLIC_URL=https://change-me.example.com

# Number of reverse proxies in front of the app (default 0).
TRUSTED_PROXY_COUNT=0

# Optional. Creates the first instance admin from the environment.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
